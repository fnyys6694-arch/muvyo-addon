{
  "api": 1,
  "id": "fnyys6694-arch.guanying",
  "name": "观影",
  "version": "1.1.2",
  "author": "fnyys",
  "description": "用你的观影站账号搜索 115、光鸭、123 网盘分享和磁力资源。",
  "min_mv_version": "",
  "permissions": {
    "domains": [],
    "service": {
      "label": "观影站点地址",
      "help": "站点域名会轮换，填你现在能打开的那个，例如 https://www.example.com"
    }
  },
  "config": [
    {
      "key": "username",
      "label": "用户名",
      "type": "text",
      "required": true,
      "help": "观影站的登录账号"
    },
    {
      "key": "password",
      "label": "密码",
      "type": "secret",
      "required": true
    },
    {
      "key": "max_magnet_candidates",
      "label": "磁力解析条数",
      "type": "number",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "条",
      "default": "5",
      "help": "磁力要逐条打开种子页才拿得到，只解析列表前几条；0 表示不搜磁力"
    }
  ],
  "settings": {
    "description": "填写观影站地址和你的账号。插件会自动通过站点的浏览器验证并登录，登录状态保存在插件数据里；站点要求图形验证码时，先在浏览器里登录一次再试。",
    "sections": [
      {
        "title": "账号",
        "fields": [
          "username",
          "password"
        ]
      },
      {
        "title": "磁力",
        "fields": [
          "max_magnet_candidates"
        ]
      }
    ]
  },
  "capabilities": {
    "search": {
      "link_types": [
        "115",
        "guangyapan",
        "123pan",
        "magnet"
      ],
      "supports_tmdb": false
    }
  }
}